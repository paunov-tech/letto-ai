# ═══════════════════════════════════════════════
# LETTO.LIVE — Environment Variables
# ═══════════════════════════════════════════════

# ─── Claude API ─────────────────────────────────
# Used for: blurb writing, NLP search parsing
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ─── Stripe ─────────────────────────────────────
# Used for: Premium subscription checkout + webhooks
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# LETTO Premium: €29 every 3 months, recurring
STRIPE_PREMIUM_PRICE_ID=price_xxxxx
# Beta coupon: €10 off (effective €19/3mo), max_redemptions=100
STRIPE_BETA_COUPON_ID=FIRST100

# Client-exposed (safe to use with VITE_ prefix)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# ─── Meta Conversions API (server-side Pixel · v28) ─
# Used for: Subscribe event from Stripe webhook · defeats ad-blockers,
#           recovers ~20-40% of attribution lost to client-side blocking
# Get from: business.facebook.com/events_manager → Pixel 2513952102382319
#           → Settings → Conversions API → Generate access token
# Without this set, lib/meta-capi.js sendCapiEvent() is a silent no-op
META_CAPI_ACCESS_TOKEN=EAAxxxxx
# Optional · routes events to Events Manager → Test Events tab without
# polluting production stats. Generate code in that tab.
META_CAPI_TEST_EVENT_CODE=

# ─── Firebase ───────────────────────────────────
# Used for: User data, subscription state, deal storage
# Get from: https://console.firebase.google.com/
# Reuse existing molty-portal or create new "letto-ai" project
VITE_FIREBASE_API_KEY=xxxxx
VITE_FIREBASE_AUTH_DOMAIN=letto-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=letto-ai
VITE_FIREBASE_STORAGE_BUCKET=letto-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=xxxxx
VITE_FIREBASE_APP_ID=1:xxxxx:web:xxxxx

# Server-side (admin SDK)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@letto-ai.iam.gserviceaccount.com

# ─── Telegram Bot ───────────────────────────────
# Used for: Membership gating, deal broadcasting
# Create bot: message @BotFather on Telegram
TELEGRAM_BOT_TOKEN=xxxxx:xxxxx
TELEGRAM_PUBLIC_CHANNEL_ID=-100xxxxx  # @letto_live_deals
TELEGRAM_PREMIUM_CHANNEL_ID=-100xxxxx # @letto_live_premium

# ─── Kiwi.com Tequila ───────────────────────────
# Used for: Flight price scanning
# Register: https://tequila.kiwi.com/portal/register
KIWI_API_KEY=xxxxx

# ─── Travelpayouts (optional, additional flights source) ─
TRAVELPAYOUTS_API_KEY=xxxxx
TRAVELPAYOUTS_MARKER=xxxxx

# ─── Mailchimp / Substack (newsletter) ──────────
MAILCHIMP_API_KEY=xxxxx
MAILCHIMP_LIST_ID=xxxxx
MAILCHIMP_SERVER_PREFIX=usXX

# ─── n8n Webhook (for deal pipeline) ────────────
N8N_WEBHOOK_URL=https://n8n.paunov.tech/webhook/letto-deal-publish
N8N_WEBHOOK_SECRET=xxxxx

# ─── Public site config ─────────────────────────
VITE_SITE_URL=https://letto.live
VITE_PUBLIC_TELEGRAM_LINK=https://t.me/letto_ai_deals
VITE_CONTACT_EMAIL=info@letto.live

# ─── Feature flags ──────────────────────────────
VITE_ENABLE_AI_SEARCH=true
VITE_ENABLE_BETA_PRICING=true

# ════════════════════════════════════════════════════════════════════════
# v35 · documented to close gap audit found: 14 vars used by api/* + lib/*
# but previously undocumented here, risking silent prod failure on a fresh
# deploy. Set every section that's actually wired up — silent no-ops are
# acceptable for optional ones (Sentry / Slack / CJ).
# ════════════════════════════════════════════════════════════════════════

# ─── Resend (transactional email · welcome + Mix confirmation) ─────────
# Used by: api/stripe-webhook.js (welcome + Mix confirmation), api/admin.js
#          (retry-failed-emails cron), api/recovery.js (magic-link send)
# Get from: https://resend.com/api-keys
# Without RESEND_API_KEY: every email send is a silent failure → persisted
# to failed_email_sends + Slack alert. Domain must be verified at
# https://resend.com/domains (letto.live or sial.com).
RESEND_API_KEY=re_xxxxx
# Optional · explicit From header, e.g. "Letto Mix <mix@letto.live>".
# If unset, auto-discovers verified domain (letto.live → sial.com → first).
RESEND_FROM=
# Optional · Reply-To header when From domain differs from podrska@.
RESEND_REPLY_TO=

# ─── RapidAPI (Hotels.com) ─────────────────────────────────────────────
# Used by: api/hotels-search.js (Mix flow hotel offers)
# Get from: https://rapidapi.com/apidojo/api/hotels-com-provider
RAPIDAPI_KEY=xxxxx

# ─── Admin / Cron auth ─────────────────────────────────────────────────
# Used by: api/admin.js (?token=ADMIN_TOKEN), Vercel cron triggers
# (Authorization: Bearer CRON_SECRET — Vercel attaches it automatically
# when the schedule fires). Both must be long random strings.
ADMIN_TOKEN=xxxxx
CRON_SECRET=xxxxx

# ─── Telegram admin alerts + bot webhook auth ──────────────────────────
# TELEGRAM_ADMIN_CHAT_ID is your own chat with the bot — gets webhook /
# email / payment-failed alerts. TELEGRAM_WEBHOOK_SECRET protects the
# /api/telegram-webhook endpoint (set in the bot's webhook URL).
TELEGRAM_ADMIN_CHAT_ID=xxxxx
TELEGRAM_WEBHOOK_SECRET=xxxxx

# ─── Sentry (backend error monitoring) ─────────────────────────────────
# Used by: lib/sentry-backend.js · wrapped around 14 of 20 api/*.js
# endpoints. Without DSN, withSentry() falls through to bare handler.
# Get from: https://sentry.io → project settings → Client Keys (DSN)
SENTRY_DSN_BACKEND=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ─── Slack alerts (ops-critical failure pings) ─────────────────────────
# Used by: api/stripe-webhook.js (failed welcome email, currency mismatch,
# orphan purchase, invoice.payment_failed). Silent no-op if unset.
# Create: https://api.slack.com/messaging/webhooks
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── Lead-capture IP hashing ───────────────────────────────────────────
# Used by: lead-capture flow to dedup leads without storing raw IPs.
# Any long random string · changing it rotates the dedup namespace.
LEAD_IP_HASH_SALT=xxxxx

# ─── Notify-admin secret ───────────────────────────────────────────────
# Used by: api/notify-admin.js (POST ?secret=NOTIFY_SECRET)
NOTIFY_SECRET=xxxxx

# ─── Firebase Storage backup (daily Firestore export) ──────────────────
# Used by: api/admin.js?action=daily-firestore-export cron (04:00 UTC).
# GCS bucket name (no gs:// prefix), e.g. "letto-ai-backups".
FIREBASE_BACKUP_BUCKET=letto-ai-backups

# ─── Commission Junction (optional affiliate · hotel deeplinks) ────────
# Used by: api/cj-refresh.js. Optional — without these CJ enrichment is
# skipped, hotel.bookingUrl still falls back to direct partner URLs.
CJ_API_TOKEN=xxxxx
CJ_CID=xxxxx
CJ_PID=xxxxx
